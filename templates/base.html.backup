<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}El Solterito - Gestión de Inventario{% endblock %}</title>
    <!-- Tailwind CSS CDN con configuración para modo oscuro -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class'
        }
    </script>
    <!-- Fuentes de Google (opcional) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    {% load static %}
    <link rel="stylesheet" href="{% static 'css/estilo.css' %}">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
    <!-- Alpine.js para interactividad ligera -->
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script>
        // Inicializar tema después de Alpine.js
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM loaded, initializing theme...');
            const saved = localStorage.getItem('theme');
            const prefers = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            const theme = saved || (prefers ? 'dark' : 'light');
            console.log('Initial theme:', theme);
            document.documentElement.classList.toggle('dark', theme === 'dark');

            // Aplicar colores iniciales al body
            const body = document.body;
            if (theme === 'dark') {
                body.style.backgroundColor = '#1f2937'; // gray-800
                body.style.color = '#f9fafb'; // gray-50
            } else {
                body.style.backgroundColor = '#f3f4f6'; // gray-100
                body.style.color = '#111827'; // gray-900
            }

            localStorage.setItem('theme', theme);

            // Función global para toggle del tema
            window.toggleTheme = function() {
                console.log('toggleTheme called');
                const html = document.documentElement;
                const body = document.body;
                const current = html.classList.contains('dark') ? 'dark' : 'light';
                const next = current === 'dark' ? 'light' : 'dark';
                console.log('Switching from', current, 'to', next);
                html.classList.toggle('dark', next === 'dark');

                // Cambiar background del body directamente para probar
                if (next === 'dark') {
                    body.style.backgroundColor = '#1f2937'; // gray-800
                    body.style.color = '#f9fafb'; // gray-50
                } else {
                    body.style.backgroundColor = '#f3f4f6'; // gray-100
                    body.style.color = '#111827'; // gray-900
                }

                localStorage.setItem('theme', next);
                updateThemeIcons(next);
                console.log('Theme switched to:', next);
            };

            // Función para actualizar iconos
            function updateThemeIcons(theme) {
                const iconSun = document.getElementById('theme-icon-sun');
                const iconMoon = document.getElementById('theme-icon-moon');
                const text = document.getElementById('theme-text');
                console.log('Updating icons for theme:', theme, 'Elements found:', { iconSun: !!iconSun, iconMoon: !!iconMoon, text: !!text });
                if (iconSun && iconMoon && text) {
                    if (theme === 'dark') {
                        iconSun.classList.remove('hidden');
                        iconMoon.classList.add('hidden');
                        text.textContent = 'Modo claro';
                    } else {
                        iconSun.classList.add('hidden');
                        iconMoon.classList.remove('hidden');
                        text.textContent = 'Modo oscuro';
                    }
                }
            }

            // Sincronizar iconos iniciales después de un pequeño delay para asegurar que los elementos existen
            setTimeout(() => {
                updateThemeIcons(theme);
            }, 100);

            // Agregar event listener al botón cuando esté disponible
            const checkButton = () => {
                const button = document.getElementById('theme-toggle');
                if (button) {
                    console.log('Button found, adding event listener');
                    button.addEventListener('click', (e) => {
                        e.stopPropagation();
                        console.log('Button clicked via vanilla JS');
                        window.toggleTheme();
                    });
                } else {
                    setTimeout(checkButton, 50);
                }
            };
            checkButton();
        });
    </script>
    {% load static %}
    <script src="{% static 'js/app.js' %}"></script>
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-800 dark:text-gray-200 antialiased" x-data="{ mobileMenu: false }">

    {% if request.resolver_match.url_name != 'login' %}
    <!-- Navbar mejorado con diseño moderno y responsive -->
    <nav class="bg-white dark:bg-gray-800 shadow-md border-b border-gray-200 dark:border-gray-700 sticky top-0 z-50">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo / Marca -->
                <div class="flex-shrink-0">
                    <a href="{% url 'inventario:lista_productos' %}" class="text-2xl font-bold text-primary hover:text-teal-800 transition">
                        El Solterito
                    </a>
                </div>

                <!-- Menú para desktop (oculto en móvil) -->
                <div class="hidden md:flex md:items-center md:space-x-1">
                    <a href="{% url 'inventario:lista_productos' %}" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-primary hover:bg-teal-50 dark:hover:bg-teal-900 transition">Inicio</a>
                    <a href="{% url 'inventario:lista_movimientos' %}" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-primary hover:bg-teal-50 dark:hover:bg-teal-900 transition">Movimientos</a>
                    <a href="{% url 'inventario:reportes' %}" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-primary hover:bg-teal-50 dark:hover:bg-teal-900 transition">Reportes</a>
                    {% if user.is_authenticated %}
                        <a href="{% url 'inventario:crear_producto' %}" class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-primary hover:bg-teal-50 dark:hover:bg-teal-900 transition">Nuevo producto</a>
                        
                        <div class="relative ml-3" x-data="{ open: false }" @click.away="open = false">
                            <button id="user-dropdown-button" @click="open = !open" :aria-expanded="open" aria-label="Menú de usuario" class="flex items-center space-x-2 px-3 py-2 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-teal-50 dark:hover:bg-teal-900 focus:outline-none focus:ring-2 focus:ring-teal-500">
                                <span>{{ user.username }}</span>
                                <svg class="h-4 w-4 transition-transform" :class="{'rotate-180': open}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </button>
                            <!-- Dropdown (controlado por Alpine.js) -->
                            <div x-show="open" x-transition class="absolute right-0 mt-2 w-48 bg-white dark:bg-gray-800 rounded-md shadow-lg py-1 border border-gray-200 dark:border-gray-700">
                                <!-- Toggle tema oscuro -->
                                <div class="px-4 py-2 border-b border-gray-200 dark:border-gray-700">
                                    <button id="theme-toggle" class="flex items-center space-x-2 w-full text-left text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 px-2 py-1 rounded">
                                        <svg id="theme-icon-sun" class="h-4 w-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                                        </svg>
                                        <svg id="theme-icon-moon" class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                                        </svg>
                                        <span id="theme-text">Modo oscuro</span>
                                    </button>
                                </div>
                                <form method="post" action="{% url 'logout' %}">
                                    {% csrf_token %}
                                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
                                        Cerrar sesión
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% else %}
                        <a href="{% url 'login' %}" class="px-4 py-2 rounded-md text-sm font-medium text-white bg-primary hover:bg-teal-800 transition shadow-sm">Iniciar sesión</a>
                    {% endif %}
                </div>

                <!-- Botón de menú móvil (hamburguesa) -->
                <div class="md:hidden flex items-center">
                    <button type="button" @click="mobileMenu = !mobileMenu" :aria-expanded="mobileMenu" aria-label="Abrir menú móvil" class="text-gray-700 dark:text-gray-300 hover:text-primary focus:outline-none focus:ring-2 focus:ring-teal-500 p-2 rounded">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Menú móvil (controlado por Alpine.js) -->
        <div class="md:hidden" x-show="mobileMenu" x-transition @click.away="mobileMenu = false">
            <div class="px-2 pt-2 pb-3 space-y-1 bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700">
                <a href="{% url 'inventario:lista_productos' %}" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 dark:text-gray-300 hover:text-primary hover:bg-teal-50 dark:hover:bg-teal-900">Inicio</a>
                <a href="{% url 'inventario:lista_movimientos' %}" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 dark:text-gray-300 hover:text-primary hover:bg-teal-50 dark:hover:bg-teal-900">Movimientos</a>
                <a href="{% url 'inventario:reportes' %}" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 dark:text-gray-300 hover:text-primary hover:bg-teal-50 dark:hover:bg-teal-900">Reportes</a>
                {% if user.is_authenticated %}
                    <a href="{% url 'inventario:crear_producto' %}" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 dark:text-gray-300 hover:text-primary hover:bg-teal-50 dark:hover:bg-teal-900">Nuevo producto</a>
                    <span class="block px-3 py-2 text-base font-medium text-gray-500 dark:text-gray-400">Hola, {{ user.username }}</span>
                    <form method="post" action="{% url 'logout' %}">
                        {% csrf_token %}
                        <button type="submit" class="w-full text-left px-3 py-2 rounded-md text-base font-medium text-gray-700 dark:text-gray-300 hover:text-primary hover:bg-teal-50 dark:hover:bg-teal-900">
                            Cerrar sesión
                        </button>
                    </form>
                {% else %}
                    <a href="{% url 'login' %}" class="block px-3 py-2 rounded-md text-base font-medium text-white bg-primary hover:bg-teal-800">Iniciar sesión</a>
                {% endif %}
            </div>
        </div>
    </nav>
    {% endif %}

    <!-- Mensajes flash convertidos a toasts -->
    {% if messages %}
        <div style="display: none;">
            {% for message in messages %}
                <div data-toast="{{ message|escapejs }}" data-toast-type="{{ message.tags|default:'info' }}"></div>
            {% endfor %}
        </div>
    {% endif %}

    <!-- Contenido principal -->
    <main class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {% block content %}{% endblock %}
    </main>

    <!-- Contenedor de toasts -->
    <div id="toast-container" class="fixed bottom-4 right-4 z-50 space-y-2"></div>

    <!-- Footer simple (opcional) -->
    {% if request.resolver_match.url_name != 'login' %}
    <footer class="bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 mt-12">
        <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-4 text-center text-gray-500 dark:text-gray-400 text-sm">
            &copy; {% now "Y" %} Tienda El Solterito - Sistema de Gestión de Inventario
        </div>
    </footer>
    {% endif %}

</body>
</html>