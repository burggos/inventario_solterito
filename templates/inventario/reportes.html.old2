{% extends 'base.html' %}
{% load static %}

{% block title %}Reportes - El Solterito{% endblock %}
{% block page_title %}Reportes{% endblock %}

{% block content %}
    <div class="mb-6">
        <h2 class="text-2xl font-bold text-gray-800 dark:text-white">Dashboard de Reportes</h2>
        <p class="text-gray-500 dark:text-gray-400 mt-1">Visión general del inventario y movimientos en tiempo real</p>
    </div>

    <!-- Filtro por rango de fechas -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-5 mb-6">
        <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-200 mb-4">Filtrar por período</h2>
        <form method="get" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5 items-end">
            <div>
                <label for="desde" class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1">Desde</label>
                <input id="desde" name="desde" type="date" value="{{ fecha_desde }}">
            </div>
            <div>
                <label for="hasta" class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1">Hasta</label>
                <input id="hasta" name="hasta" type="date" value="{{ fecha_hasta }}">
            </div>
            <div>
                <label for="grouping" class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-1">Agrupar por</label>
                <select id="grouping" name="grouping">
                    <option value="dia" {% if grouping == 'dia' %}selected{% endif %}>Día</option>
                    <option value="semana" {% if grouping == 'semana' %}selected{% endif %}>Semana</option>
                    <option value="mes" {% if grouping == 'mes' %}selected{% endif %}>Mes</option>
                    <option value="ano" {% if grouping == 'ano' %}selected{% endif %}>Año</option>
                </select>
            </div>
            <div class="flex items-center gap-2">
                <button type="submit" class="btn-primary">Aplicar filtro</button>
                <a href="{% url 'inventario:reportes' %}" class="btn-outline">Limpiar</a>
            </div>
        </form>
    </div>

    <!-- KPIs Principales -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 border-t-4 border-t-teal-500 dark:border-t-teal-700 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Total Productos</p>
                    <p class="text-3xl font-bold text-teal-600 dark:text-teal-400 mt-2">{{ total_productos }}</p>
                </div>
                <svg class="w-10 h-10 text-teal-200 dark:text-teal-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 border-t-4 border-t-blue-500 dark:border-t-blue-600 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Valor Inventario</p>
                    <p class="text-2xl font-bold text-blue-600 dark:text-blue-400 mt-2">COP {{ valor_inventario|floatformat:0 }}</p>
                </div>
                <svg class="w-10 h-10 text-blue-200 dark:text-blue-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 border-t-4 border-t-orange-500 dark:border-t-orange-600 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Stock Bajo</p>
                    <p class="text-3xl font-bold text-orange-600 dark:text-orange-400 mt-2">{{ productos_stock_bajo }}</p>
                    <p class="text-xs text-orange-500 mt-1">Requiere atención</p>
                </div>
                <svg class="w-10 h-10 text-orange-200 dark:text-orange-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.068 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
            </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 border-t-4 border-t-green-500 dark:border-t-green-600 p-6">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide">Movimientos Hoy</p>
                    <p class="text-3xl font-bold text-green-600 dark:text-green-400 mt-2">{{ movimientos_hoy }}</p>
                    <p class="text-xs text-green-500 mt-1">Actividad actual</p>
                </div>
                <svg class="w-10 h-10 text-green-200 dark:text-green-800" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            </div>
        </div>
    </div>

    <!-- Sección de Alertas y Resumen del Rango en Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
        <!-- Tabla de Alertas: Stock Crítico -->
        <div class="lg:col-span-2 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-200">Productos con Stock Crítico</h2>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400">{{ productos_stock_bajo }} críticos</span>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider border-b border-gray-200 dark:border-gray-700">
                            <th class="pb-3 pr-4">Producto</th>
                            <th class="pb-3 pr-4">Stock Actual</th>
                            <th class="pb-3 pr-4">Stock Mínimo</th>
                            <th class="pb-3">Acción</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                        {% for producto in productos_criticos %}
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                            <td class="py-3 pr-4 font-medium text-gray-800 dark:text-gray-200">{{ producto.nombre }}</td>
                            <td class="py-3 pr-4"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400">{{ producto.stock }}</span></td>
                            <td class="py-3 pr-4 text-gray-600 dark:text-gray-400">{{ producto.stock_minimo }}</td>
                            <td class="py-3">
                                <a href="{% url 'inventario:crear_movimiento' %}?producto={{ producto.pk }}" class="text-xs font-medium text-teal-600 dark:text-teal-400 hover:text-teal-800 dark:hover:text-teal-300 transition">+ Entrada</a>
                            </td>
                        </tr>
                        {% empty %}
                        <tr>
                            <td colspan="4" class="py-8 text-center text-gray-400 dark:text-gray-500">
                                <svg class="w-8 h-8 mx-auto mb-2 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                Todo el inventario está en orden
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Resumen del rango -->
        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 border-t-4 border-t-teal-500 dark:border-t-teal-700 p-6">
            <h3 class="text-sm font-semibold text-gray-800 dark:text-gray-200 mb-4">Resumen del Período</h3>
            <div class="space-y-4">
                <div class="p-4 bg-teal-50 dark:bg-teal-900/20 rounded-lg border border-teal-200 dark:border-teal-800">
                    <p class="text-xs text-teal-600 dark:text-teal-400 uppercase font-semibold tracking-wide">Rango Seleccionado</p>
                    <p class="text-lg font-bold text-teal-800 dark:text-teal-200 mt-2">{{ rango_label }}</p>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="p-4 bg-indigo-50 dark:bg-indigo-900/20 rounded-lg border border-indigo-200 dark:border-indigo-800">
                        <p class="text-xs text-indigo-600 dark:text-indigo-400 uppercase font-semibold tracking-wide">Total Movimientos</p>
                        <p class="text-2xl font-bold text-indigo-700 dark:text-indigo-300 mt-2">{{ total_movimientos_rango }}</p>
                    </div>
                    <div class="p-4 bg-emerald-50 dark:bg-emerald-900/20 rounded-lg border border-emerald-200 dark:border-emerald-800">
                        <p class="text-xs text-emerald-600 dark:text-emerald-400 uppercase font-semibold tracking-wide">Entradas</p>
                        <p class="text-2xl font-bold text-emerald-700 dark:text-emerald-300 mt-2">{{ total_entradas_rango }}</p>
                    </div>
                    <div class="p-4 bg-rose-50 dark:bg-rose-900/20 rounded-lg border border-rose-200 dark:border-rose-800 col-span-2">
                        <p class="text-xs text-rose-600 dark:text-rose-400 uppercase font-semibold tracking-wide">Salidas</p>
                        <p class="text-2xl font-bold text-rose-700 dark:text-rose-300 mt-2">{{ total_salidas_rango }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Análisis de Tendencias -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-6">
        <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-200 mb-4">
            Tendencia 
            {% if grouping == 'semana' %}
                Semanal
            {% elif grouping == 'mes' %}
                Mensual
            {% elif grouping == 'ano' %}
                Anual
            {% else %}
                Diaria
            {% endif %}
            de Movimientos
        </h2>
        <div class="bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-900 dark:to-slate-800 rounded-lg p-4">
            <canvas id="movimientosChart" height="80"></canvas>
        </div>
    </div>

    <!-- Distribución de Productos Vendidos -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-6">
        <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-200 mb-4">
            Distribución de Ventas por Producto
        </h2>
        <div class="flex justify-center">
            <div class="w-full max-w-md bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-900 dark:to-slate-800 rounded-lg p-6">
                <canvas id="productosDistribucionChart" height="80"></canvas>
            </div>
        </div>
    </div>

    <!-- Productos Más Vendidos -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-8">
        <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-200 mb-4">Productos Más Vendidos</h2>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider border-b border-gray-200 dark:border-gray-700">
                        <th class="pb-3 pr-4 w-12 text-center">Pos</th>
                        <th class="pb-3 pr-4">Producto</th>
                        <th class="pb-3 pr-4">Categoría</th>
                        <th class="pb-3 text-center">Vendidas</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
                    {% for producto in productos_mas_vendidos %}
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50 transition">
                        <td class="py-3 pr-4 text-center">
                            {% if forloop.counter == 1 %}
                                <span class="text-2xl">🥇</span>
                            {% elif forloop.counter == 2 %}
                                <span class="text-2xl">🥈</span>
                            {% elif forloop.counter == 3 %}
                                <span class="text-2xl">🥉</span>
                            {% else %}
                                <span class="inline-flex items-center justify-center bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 font-semibold rounded-full w-7 h-7 text-sm">#{{ forloop.counter }}</span>
                            {% endif %}
                        </td>
                        <td class="py-3 pr-4">
                            <a href="{% url 'inventario:detalle_producto' producto.pk %}" class="text-teal-600 dark:text-teal-400 hover:text-teal-700 dark:hover:text-teal-300 font-medium transition">{{ producto.nombre }}</a>
                        </td>
                        <td class="py-3 pr-4 text-gray-600 dark:text-gray-400">{{ producto.categoria.nombre|default:"-" }}</td>
                        <td class="py-3 text-center"><span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400">{{ producto.total_vendido|default:0 }}</span></td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="4" class="py-8 text-center text-gray-400 dark:text-gray-500">
                            <svg class="w-8 h-8 mx-auto mb-2 text-gray-300 dark:text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                            No hay datos de ventas disponibles
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

<!-- Script para el gráfico con Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('movimientosChart').getContext('2d');
        const movimientos = {{ movimientos_chart_json|safe }};
        
        const labels = movimientos.map(item => item.label);
        const entradas = movimientos.map(item => item.entradas);
        const salidas = movimientos.map(item => item.salidas);
        
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Entradas',
                        data: entradas,
                        backgroundColor: 'rgba(59, 130, 246, 0.7)',
                        borderColor: 'rgba(59, 130, 246, 1)',
                        borderWidth: 2,
                        borderRadius: 6
                    },
                    {
                        label: 'Salidas',
                        data: salidas,
                        backgroundColor: 'rgba(239, 68, 68, 0.7)',
                        borderColor: 'rgba(239, 68, 68, 1)',
                        borderWidth: 2,
                        borderRadius: 6
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            color: '#64748b',
                            font: {
                                size: 13,
                                weight: '500'
                            },
                            padding: 15,
                            usePointStyle: true
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        titleColor: '#fff',
                        bodyColor: '#fff',
                        borderColor: '#0f766e',
                        borderWidth: 1,
                        padding: 12,
                        displayColors: true,
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': ' + context.parsed.y + ' unidades';
                            }
                        }
                    }
                },
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                scales: {
                    x: {
                        title: {
                            display: true,
                            text: 'Día',
                            color: '#64748b',
                            font: { size: 13, weight: '500' }
                        },
                        ticks: {
                            color: '#64748b',
                            font: { size: 12 }
                        },
                        grid: {
                            color: '#e2e8f0',
                            drawBorder: false
                        }
                    },
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Movimientos',
                            color: '#64748b',
                            font: { size: 13, weight: '500' }
                        },
                        ticks: {
                            stepSize: 1,
                            color: '#64748b',
                            font: { size: 12 }
                        },
                        grid: {
                            color: '#e2e8f0',
                            drawBorder: false
                        }
                    }
                }
            }
        });

        // Gráfico de Dónut - Distribución de Productos Vendidos
        const ctxDonut = document.getElementById('productosDistribucionChart').getContext('2d');
        const productosData = {{ top_productos_chart_json|safe }};
        
        const colores = [
            'rgba(239, 68, 68, 0.8)',    // Rojo
            'rgba(59, 130, 246, 0.8)',   // Azul
            'rgba(34, 197, 94, 0.8)',    // Verde
            'rgba(250, 204, 21, 0.8)',   // Amarillo
            'rgba(139, 92, 246, 0.8)',   // Púrpura
            'rgba(14, 165, 233, 0.8)',   // Cian
            'rgba(248, 113, 113, 0.8)',  // Rojo claro
            'rgba(251, 146, 60, 0.8)',   // Naranja
            'rgba(168, 85, 247, 0.8)',   // Violeta
            'rgba(6, 182, 212, 0.8)'     // Turquesa
        ];

        const bordeColores = colores.map(c => c.replace('0.8', '1'));

        new Chart(ctxDonut, {
            type: 'doughnut',
            data: {
                labels: productosData.map(p => p.nombre),
                datasets: [{
                    data: productosData.map(p => p.cantidad),
                    backgroundColor: colores.slice(0, productosData.length),
                    borderColor: bordeColores.slice(0, productosData.length),
                    borderWidth: 2,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            color: '#64748b',
                            font: {
                                size: 12,
                                weight: '500'
                            },
                            padding: 15,
                            usePointStyle: true,
                            pointStyle: 'circle'
                        }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(0, 0, 0, 0.8)',
                        titleColor: '#fff',
                        bodyColor: '#fff',
                        borderColor: '#0f766e',
                        borderWidth: 1,
                        padding: 12,
                        callbacks: {
                            label: function(context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percentage = ((context.parsed / total) * 100).toFixed(1);
                                return context.label + ': ' + context.parsed + ' (' + percentage + '%)';
                            }
                        }
                    }
                }
            }
        });
    });
</script>
{% endblock %}
