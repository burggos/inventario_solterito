# Entorno general
DJANGO_ENV=development
DJANGO_DEBUG=True

# Clave secreta (obligatoria en produccion)
DJANGO_SECRET_KEY=change-me-in-production-with-a-long-random-secret

# Hosts y CSRF (separados por coma)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,testserver,.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.pythonanywhere.com

# Seguridad en produccion
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_USE_X_FORWARDED_PROTO=True

# Base de datos (opcional PostgreSQL)
DJANGO_DB_ENGINE=sqlite
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432
